# Node dependencies
node_modules/

# Build output
bin/
dist/
lib/
out/
package/
build/
logs/
.next/

# Exception: wiki/lib is SOURCE (nav config), not build output — keep it tracked.
!wiki/lib/
!wiki/lib/**

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
.venv/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.spec
requirements-dev.txt

# TypeScript
*.tsbuildinfo

# OpenTofu / Terraform (wiki/ci/iac)
.terraform/
*.tfplan
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep the provider lock file committed (.terraform.lock.hcl) — do NOT ignore it.

# Env files + build-generated version stamp (package.py writes resources/VERSION)
VERSION
.env
.env.*.local

# Keys / credentials — never commit key material
*.pem
*.key
*.pfx
*.p12
id_rsa*
credentials*

# Generated tfvars (rendered FROM Secrets Manager — may carry real infra values)
*.auto.tfvars
*.auto.tfvars.json

# OS
.DS_Store
Thumbs.db
*.iss

# Editors
.vscode/
.idea/

# Exception: cli/package is the CLI PACKAGER SOURCE (package.py + the Inno Setup
# .iss), not build output — CI needs them to build the release. Build artifacts
# (cli/package/target/) stay ignored.
!cli/package/
!cli/package/package.py
!cli/package/install.sh
!cli/package/installer/
!cli/package/installer/foundry-cli-installer-setup.iss
